@page
@model CreateModel

<h1>Add New Color</h1>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div>
        <label for="ColorName">Color Name</label>
        <input type="text" id="ColorName" name="NewColor.ColorName" value="@Model.NewColor.ColorName" required>
        <span asp-validation-for="NewColor.ColorName" class="text-danger"></span>
    </div>
    <div>
        <label for="Price">Price</label>
        <input type="number" id="Price" name="NewColor.Price" value="@Model.NewColor.Price" required>
        <span asp-validation-for="NewColor.Price" class="text-danger"></span>
    </div>
    <div>
        <label for="DisplayOrder">Display Order</label>
        <input type="number" id="DisplayOrder" name="NewColor.DisplayOrder" value="@Model.NewColor.DisplayOrder" required>
        <span asp-validation-for="NewColor.DisplayOrder" class="text-danger"></span>
    </div>
    <div>
        <label for="InStock">In Stock</label>
        <input type="hidden" name="NewColor.InStock" value="false" />
        <input type="checkbox" id="InStock" name="NewColor.InStock" value="true" @(Model.NewColor.InStock ? "checked" : "")>
        <span asp-validation-for="NewColor.InStock" class="text-danger"></span>
    </div>
    <button type="submit">Save</button>
    <a asp-page="./Index">Cancel</a>
</form>

